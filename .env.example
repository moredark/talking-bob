# Required bot runtime
# PostgreSQL URL (postgres: or postgresql:)
DATABASE_URL="postgresql://bob:bob@localhost:5432/talkingbob"
TELEGRAM_BOT_TOKEN=your_bot_token_here
CLOUD_RU_API_KEY=your_cloud_ru_api_key_here

# Optional bot runtime (defaults and inclusive integer ranges shown)
# 3000; 1..65535
PORT=3000
# HTTP(S) URL
LLM_API_URL=https://foundation-models.api.cloud.ru/v1/chat/completions
LLM_MODEL=zai-org/GLM-4.7
# 4; 1..100
TELEGRAM_UPDATE_CONCURRENCY=4
# 40000; 5000..120000 ms
TELEGRAM_API_TIMEOUT_MS=40000
# 2; 1..50 active requests
AI_REQUEST_CONCURRENCY=2
# 8; 0..1000 pending requests
AI_REQUEST_MAX_PENDING=8
# 30000; 100..600000 ms
RUNTIME_SHUTDOWN_DRAIN_TIMEOUT_MS=30000
# 2500; 64..32000
LLM_ANALYSIS_MAX_TOKENS=2500
# 1200; 64..32000
LLM_FOLLOWUP_MAX_TOKENS=1200
# 300; 1..300 seconds
VOICE_MAX_DURATION_SECONDS=300
# 20971520; 1..20971520 bytes
VOICE_MAX_FILE_SIZE_BYTES=20971520
# 30000; 100..30000 ms
TELEGRAM_FILE_DOWNLOAD_TIMEOUT_MS=30000
# 20971520; 1..20971520 bytes
TELEGRAM_FILE_DOWNLOAD_MAX_RESPONSE_BYTES=20971520
# 120000; 100..120000 ms
WHISPER_REQUEST_TIMEOUT_MS=120000
# 1048576; 1..1048576 bytes
WHISPER_REQUEST_MAX_RESPONSE_BYTES=1048576
# 90000; 100..90000 ms
LLM_REQUEST_TIMEOUT_MS=90000
# 1048576; 1..1048576 bytes
LLM_REQUEST_MAX_RESPONSE_BYTES=1048576

# Optional retention (30; 1..3650 absolute 24-hour days)
RETENTION_CLOSED_CONVERSATION_CONTENT_DAYS=30
RETENTION_RATE_LIMIT_DAYS=30
RETENTION_ERROR_LOGS_DAYS=30

# Compose PostgreSQL service only. Because Compose interpolates these into a
# URL, use URI-unreserved characters only: A-Z a-z 0-9 . _ ~ -
POSTGRES_USER=bob
POSTGRES_PASSWORD=bob
POSTGRES_DB=talkingbob

# Required only by compose.production.yml. Use registry repository names and
# sha256 image digests produced by the same release build.
TALKING_BOB_RUNTIME_IMAGE=
TALKING_BOB_RUNTIME_DIGEST=
TALKING_BOB_INIT_IMAGE=
TALKING_BOB_INIT_DIGEST=

# Existing HTTP auth/CORS and optional seed configuration
# Set an explicit strong value in every production deployment.
JWT_SECRET=your_jwt_secret_here
ADMIN_CORS_ORIGIN=http://localhost:5173
# Optional pair, consumed only by prisma:seed/deploy:init. Leave both blank to skip.
ADMIN_USERNAME=
ADMIN_PASSWORD=
