# Database
DATABASE_URL="postgresql://bob:bob@localhost:5432/talkingbob"
POSTGRES_USER=bob
POSTGRES_PASSWORD=bob
POSTGRES_DB=talkingbob

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_UPDATE_CONCURRENCY=4
TELEGRAM_API_TIMEOUT_MS=40000
TELEGRAM_FILE_DOWNLOAD_TIMEOUT_MS=30000
TELEGRAM_FILE_DOWNLOAD_MAX_RESPONSE_BYTES=20971520

# AI - Cloud.ru (Whisper & LLM)
CLOUD_RU_API_KEY=your_cloud_ru_api_key_here
LLM_API_URL=https://foundation-models.api.cloud.ru/v1/chat/completions
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
LLM_ANALYSIS_MAX_TOKENS=2500
LLM_FOLLOWUP_MAX_TOKENS=1200
AI_REQUEST_CONCURRENCY=2
AI_REQUEST_MAX_PENDING=8
WHISPER_REQUEST_TIMEOUT_MS=120000
WHISPER_REQUEST_MAX_RESPONSE_BYTES=1048576
LLM_REQUEST_TIMEOUT_MS=90000
LLM_REQUEST_MAX_RESPONSE_BYTES=1048576

# Runtime safety (optional; values may lower, but not raise, the hard limits)
VOICE_MAX_DURATION_SECONDS=300
VOICE_MAX_FILE_SIZE_BYTES=20971520
RUNTIME_SHUTDOWN_DRAIN_TIMEOUT_MS=30000

# Admin Panel
PORT=3000
JWT_SECRET=your_jwt_secret_here
ADMIN_USERNAME=change_me_admin
ADMIN_PASSWORD=change_me_strong_password
ADMIN_CORS_ORIGIN=http://localhost:5173
