generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserPromptSource {
  manual
  scheduled
  legacy
}

enum UserPromptDeliveryStatus {
  pending
  sent
  failed
}

enum ConversationStatus {
  open
  closed
}

enum ReportGenerationStatus {
  generating
  generated
  failed
}

enum ReportAnalysisKind {
  model
  fallback
  legacy
}

enum ReportDeliveryStatus {
  pending
  delivered
  failed
}

enum StreakDayKind {
  activity
  freeze
}

enum StreakReminderStatus {
  pending
  sent
  cancelled
  failed
  expired
}

enum BroadcastMode {
  immediate
  scheduled
}

enum BroadcastStatus {
  queued
  processing
  completed
  completed_with_errors
  cancelled
}

enum BroadcastRecipientStatus {
  pending
  sent
  failed
  ambiguous
  skipped
}

model User {
  id                    String    @id @default(uuid())
  telegramId            BigInt    @unique
  username              String?
  dailyPromptEnabled    Boolean   @default(true)
  announcementEnabled   Boolean   @default(true)
  lastUserMessageAt     DateTime? @db.Timestamptz(3)
  dailyPromptHour       Int       @default(13)
  dailyPromptMinute     Int       @default(0)
  timezone              String    @default("Europe/Moscow")
  agentTone             String    @default("friendly")
  lastPromptSentAt      DateTime? @db.Timestamptz(3)
  nextPromptAt          DateTime? @db.Timestamptz(3)
  currentStreak         Int       @default(0)
  longestStreak         Int       @default(0)
  lastStreakLocalDate   DateTime? @db.Date
  streakExpiresAt       DateTime? @db.Timestamptz(3)
  streakReminderEnabled Boolean   @default(true)
  streakReminderHour    Int       @default(21)
  streakReminderMinute  Int       @default(0)
  nextStreakReminderAt  DateTime? @db.Timestamptz(3)
  languageLevel         String?
  status                String    @default("active")
  bannedAt              DateTime?
  bannedReason          String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  userPrompts         UserPrompt[]
  userResponses       UserResponse[]
  aiProviderCalls     AiProviderCall[]
  userRequests        UserRequest[]
  quotaWindows        QuotaWindow[]
  broadcastRecipients BroadcastRecipient[]
  activityDays        UserActivityDay[]
  streakDays          StreakDay[]
  streakReminders     StreakReminder[]
  personality         AgentPersonality @relation(fields: [agentTone], references: [key], onDelete: Restrict, onUpdate: Restrict)

  @@index([nextPromptAt])
  @@index([nextStreakReminderAt], map: "users_next_streak_reminder_at_idx")
  @@index([lastUserMessageAt], map: "users_lastUserMessageAt_idx")
  @@map("users")
}

model AgentPersonality {
  id                  String   @id @default(uuid()) @db.Uuid
  key                 String   @unique @db.VarChar(32)
  name                String   @db.VarChar(80)
  description         String   @db.VarChar(240)
  followUpStylePrompt String
  analysisStylePrompt String
  isActive            Boolean  @default(true)
  isDefault           Boolean  @default(false)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  users User[]
  @@index([isActive, sortOrder, createdAt, id], map: "agent_personalities_active_sort_idx")
  @@map("agent_personalities")
}

model AgentPromptRules {
  id             String   @id @default("default") @db.VarChar(16)
  followUpPrompt String
  analysisPrompt String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@map("agent_prompt_rules")
}

model Prompt {
  id          String   @id @default(uuid())
  topic       String
  textContent String?
  audioFileId String?
  difficulty  String   @default("medium")
  tags        String[] @default([])
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  userPrompts UserPrompt[]

  @@map("prompts")
}

model UserPrompt {
  id                     String                   @id @default(uuid())
  userId                 String
  promptId               String
  source                 UserPromptSource         @default(manual)
  deliveryStatus         UserPromptDeliveryStatus @default(pending)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  sentAt                 DateTime?                @db.Timestamptz(3)
  scheduledFor           DateTime?                @db.Timestamptz(3)
  scheduledOccurrenceKey String?                  @db.VarChar(64)
  scheduledLocalDate     DateTime?                @db.Date
  timezoneSnapshot       String?                  @db.VarChar(128)
  claimToken             String?                  @db.Uuid
  claimExpiresAt         DateTime?                @db.Timestamptz(3)
  deliveryAttemptedAt    DateTime?                @db.Timestamptz(3)
  lastDeliveryErrorCode  String?                  @db.VarChar(64)
  lastDeliveryErrorAt    DateTime?                @db.Timestamptz(3)
  conversationStatus     ConversationStatus       @default(open)
  conversationClosedAt   DateTime?                @db.Timestamptz(3)
  firstUserMessageAt     DateTime?                @db.Timestamptz(3)

  contentPurgedAt DateTime? @db.Timestamptz(3)
  aiTracePurgedAt DateTime? @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id])
  prompt          Prompt    @relation(fields: [promptId], references: [id])

  userResponse         UserResponse?
  conversationMessages ConversationMessage[]
  aiProviderCalls      AiProviderCall[]
  streakDay            StreakDay?

  @@index([userId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "user_prompts_user_created_id_idx")
  @@index([promptId])
  @@index([userId, deliveryStatus, sentAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "user_prompts_created_id_idx")
  @@index([deliveryStatus, deliveryAttemptedAt, claimExpiresAt], map: "user_prompts_delivery_retry_idx")
  @@index([conversationStatus, conversationClosedAt], map: "user_prompts_conversation_status_idx")
  @@index([scheduledOccurrenceKey])
  @@index([sentAt], map: "user_prompts_sent_at_idx")
  @@index([firstUserMessageAt], map: "user_prompts_first_user_message_at_idx")
  @@map("user_prompts")
}

model UserActivityDay {
  userId          String
  localDate       DateTime @db.Date
  firstActivityAt DateTime @db.Timestamptz(3)
  lastActivityAt  DateTime @db.Timestamptz(3)
  messageCount    Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, localDate])
  @@index([localDate, userId], map: "user_activity_days_local_date_user_idx")
  @@map("user_activity_days")
}

model ConversationMessage {
  id               String   @id @default(uuid())
  userPromptId     String
  role             String
  content          String
  voiceFileId      String?
  telegramUpdateId BigInt?  @unique
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  userPrompt UserPrompt @relation(fields: [userPromptId], references: [id])

  @@index([userPromptId])
  @@map("conversation_messages")
}

model UserResponse {
  id                       String                 @id @default(uuid())
  userId                   String
  userPromptId             String                 @unique
  voiceFileId              String?
  transcript               String?
  analysis                 String?
  generationStatus         ReportGenerationStatus @default(generating)
  generationRequestKey     String                 @db.VarChar(160)
  generationClaimToken     String?                @db.Uuid
  generationClaimExpiresAt DateTime?              @db.Timestamptz(3)
  generationAttemptedAt    DateTime               @db.Timestamptz(3)
  generatedAt              DateTime?              @db.Timestamptz(3)
  lastGenerationErrorCode  String?                @db.VarChar(64)
  lastGenerationErrorAt    DateTime?              @db.Timestamptz(3)
  analysisVersion          Int?
  analysisKind             ReportAnalysisKind?
  overallScore             Float?
  streakCurrentSnapshot    Int?
  streakLongestSnapshot    Int?
  streakIsNewRecord        Boolean?
  reportDeliveredAt        DateTime?              @db.Timestamptz(3)
  sensitiveDataPurgedAt    DateTime?              @db.Timestamptz(3)
  createdAt                DateTime               @default(now()) @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id])
  userPrompt UserPrompt @relation(fields: [userPromptId], references: [id])

  reportDeliveryRequests ReportDeliveryRequest[]

  aiProviderCalls AiProviderCall[]

  @@index([userId])
  @@index([generationStatus, generationAttemptedAt, generationClaimExpiresAt], map: "user_responses_generation_reclaim_idx")
  @@index([sensitiveDataPurgedAt], map: "user_responses_sensitive_data_purged_idx")
  @@index([generatedAt], map: "user_responses_generated_at_idx")
  @@index([reportDeliveredAt], map: "user_responses_report_delivered_at_idx")
  @@map("user_responses")
}

model ReportDeliveryRequest {
  id                    String               @id @default(uuid()) @db.Uuid
  userResponseId        String
  requestKey            String               @db.VarChar(160)
  chunks                Json
  nextChunkIndex        Int                  @default(0)
  status                ReportDeliveryStatus @default(pending)
  claimToken            String?              @db.Uuid
  claimExpiresAt        DateTime?            @db.Timestamptz(3)
  deliveryAttemptedAt   DateTime?            @db.Timestamptz(3)
  deliveredAt           DateTime?            @db.Timestamptz(3)
  lastDeliveryErrorCode String?              @db.VarChar(64)
  lastDeliveryErrorAt   DateTime?            @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)

  userResponse UserResponse @relation(fields: [userResponseId], references: [id])

  @@unique([userResponseId, requestKey])
  @@index([status, deliveryAttemptedAt, claimExpiresAt], map: "report_delivery_requests_reclaim_idx")
  @@map("report_delivery_requests")
}

model StreakDay {
  id                 String        @id @default(uuid())
  userId             String
  localDate          DateTime      @db.Date
  qualifiedAt        DateTime      @db.Timestamptz(3)
  timezoneSnapshot   String        @db.VarChar(128)
  kind               StreakDayKind @default(activity)
  streakLength       Int
  longestStreak      Int
  sourceUserPromptId String?       @unique
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceUserPrompt UserPrompt? @relation(fields: [sourceUserPromptId], references: [id], onDelete: SetNull)

  @@unique([userId, localDate])
  @@index([userId, localDate], map: "streak_days_user_local_date_idx")
  @@map("streak_days")
}

model StreakReminder {
  id                  String               @id @default(uuid())
  userId              String
  localDate           DateTime             @db.Date
  status              StreakReminderStatus @default(pending)
  attemptCount        Int                  @default(0)
  claimToken          String?              @db.Uuid
  claimExpiresAt      DateTime?            @db.Timestamptz(3)
  nextAttemptAt       DateTime?            @db.Timestamptz(3)
  deliveryAttemptedAt DateTime?            @db.Timestamptz(3)
  sentAt              DateTime?            @db.Timestamptz(3)
  expiresAt           DateTime             @db.Timestamptz(3)
  lastErrorCode       String?              @db.VarChar(64)
  lastErrorAt         DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([status, nextAttemptAt, claimExpiresAt], map: "streak_reminders_reclaim_idx")
  @@index([expiresAt], map: "streak_reminders_expires_at_idx")
  @@map("streak_reminders")
}

model UserRequest {
  id            String   @id @default(uuid())
  userId        String
  quotaWindowId String?
  action        String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id])
  quotaWindow QuotaWindow? @relation(fields: [quotaWindowId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, action, createdAt])
  @@index([quotaWindowId, createdAt])
  @@index([createdAt])
  @@map("user_requests")
}

model QuotaWindow {
  id               String   @id @default(uuid())
  userId           String
  action           String
  timezoneSnapshot String   @db.VarChar(128)
  windowStart      DateTime @db.Timestamptz(3)
  windowEnd        DateTime @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id])
  userRequests UserRequest[]

  @@unique([userId, action, windowStart, windowEnd])
  @@index([userId, action, windowEnd])
  @@index([windowEnd])
  @@map("quota_windows")
}

model AdminAnalyticsCoverage {
  id           String   @id
  completeFrom DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@map("admin_analytics_coverage")
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model ErrorLog {
  id            String   @id @default(uuid())
  type          String
  service       String
  operation     String   @default("unknown") @db.VarChar(80)
  correlationId String?  @db.VarChar(160)
  statusCode    Int?
  retryable     Boolean?
  latencyMs     Int?
  errorKind     String   @default("LegacyError") @db.VarChar(80)
  message       String
  stack         String?
  metadata      Json?
  userId        String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([type])
  @@index([service])
  @@index([createdAt])
  @@index([correlationId, createdAt], map: "error_logs_correlation_created_idx")
  @@index([service, operation, createdAt], map: "error_logs_service_operation_created_idx")
  @@map("error_logs")
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  actorId       String   @db.VarChar(160)
  actorUsername String
  action        String   @db.VarChar(80)
  entityType    String   @db.VarChar(80)
  entityId      String?  @db.VarChar(160)
  outcome       String   @db.VarChar(16)
  requestId     String   @db.VarChar(160)
  correlationId String   @db.VarChar(160)
  before        Json?
  after         Json?
  failureCode   String?  @db.VarChar(80)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "admin_audit_logs_created_id_idx")
  @@index([actorId, createdAt(sort: Desc), id(sort: Desc)], map: "admin_audit_logs_actor_created_id_idx")
  @@index([entityType, entityId, createdAt(sort: Desc), id(sort: Desc)], map: "admin_audit_logs_entity_created_id_idx")
  @@index([action, createdAt(sort: Desc), id(sort: Desc)], map: "admin_audit_logs_action_created_id_idx")
  @@index([outcome, createdAt(sort: Desc), id(sort: Desc)], map: "admin_audit_logs_outcome_created_id_idx")
  @@map("admin_audit_logs")
}

model AiProviderCall {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String
  userPromptId    String
  userResponseId  String?
  operation       String   @db.VarChar(32)
  provider        String   @db.VarChar(80)
  model           String   @db.VarChar(160)
  attempt         Int
  outcome         String   @db.VarChar(16)
  statusCode      Int?
  latencyMs       Int
  inputTokens     Int?
  outputTokens    Int?
  totalTokens     Int?
  responseContent String?
  failureCode     String?  @db.VarChar(80)
  correlationId   String?  @db.VarChar(160)
  requestId       String?  @db.VarChar(160)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPrompt   UserPrompt    @relation(fields: [userPromptId], references: [id], onDelete: Cascade)
  userResponse UserResponse? @relation(fields: [userResponseId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "ai_provider_calls_created_id_idx")
  @@index([userPromptId, createdAt, id], map: "ai_provider_calls_session_created_id_idx")
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "ai_provider_calls_user_created_id_idx")
  @@index([userResponseId], map: "ai_provider_calls_response_idx")
  @@map("ai_provider_calls")
}

model RuntimeSettings {
  id                      String   @id @default("singleton") @db.VarChar(32)
  productOverrides        Json     @default("{}")
  infrastructureOverrides Json     @default("{}")
  productVersion          Int      @default(0)
  infrastructureVersion   Int      @default(0)
  updatedById             String?  @db.VarChar(160)
  updatedByUsername       String?  @db.VarChar(200)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  @@map("runtime_settings")
}

model Broadcast {
  id                String          @id @default(uuid()) @db.Uuid
  content           String?
  contentPurgedAt   DateTime?       @db.Timestamptz(3)
  filters           Json
  mode              BroadcastMode
  scheduledForLocal String?         @db.VarChar(16)
  scheduledAt       DateTime        @db.Timestamptz(3)
  status            BroadcastStatus @default(queued)
  totalRecipients   Int             @default(0)
  sentCount         Int             @default(0)
  failedCount       Int             @default(0)
  ambiguousCount    Int             @default(0)
  skippedCount      Int             @default(0)
  createdById       String          @db.VarChar(160)
  createdByUsername String          @db.VarChar(200)
  terminalAt        DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  recipients BroadcastRecipient[]

  @@index([status, scheduledAt, id], map: "broadcasts_dispatch_idx")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "broadcasts_created_id_idx")
  @@index([terminalAt], map: "broadcasts_terminal_idx")
  @@map("broadcasts")
}

model BroadcastRecipient {
  id                          String                   @id @default(uuid()) @db.Uuid
  broadcastId                 String                   @db.Uuid
  userId                      String
  telegramIdSnapshot          BigInt
  usernameSnapshot            String?
  languageLevelSnapshot       String?
  dailyPromptEnabledSnapshot  Boolean
  announcementEnabledSnapshot Boolean
  status                      BroadcastRecipientStatus @default(pending)
  attemptCount                Int                      @default(0)
  claimToken                  String?                  @db.Uuid
  claimExpiresAt              DateTime?                @db.Timestamptz(3)
  nextAttemptAt               DateTime?                @db.Timestamptz(3)
  deliveryAttemptedAt         DateTime?                @db.Timestamptz(3)
  sentAt                      DateTime?                @db.Timestamptz(3)
  lastErrorCode               String?                  @db.VarChar(80)
  lastErrorAt                 DateTime?                @db.Timestamptz(3)
  createdAt                   DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                 @updatedAt @db.Timestamptz(3)

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([broadcastId, userId])
  @@index([status, nextAttemptAt, claimExpiresAt], map: "broadcast_recipients_claim_idx")
  @@index([broadcastId, status, createdAt, id], map: "broadcast_recipients_detail_idx")
  @@index([userId], map: "broadcast_recipients_user_idx")
  @@map("broadcast_recipients")
}
