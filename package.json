{
  "name": "talking-bob-bot",
  "version": "1.0.0",
  "description": "Telegram bot for practicing spoken English",
  "main": "dist/main.js",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "tsc",
    "build:seed": "tsc -p tsconfig.seed.json",
    "start": "node dist/main.js",
    "start:dev": "tsc --watch & node --watch dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "npm run build && npm run build:seed && node --test",
    "test:ci": "npm test && npx prisma validate",
    "test:smoke": "npm run build && node --test test/user-journey.test.js",
    "test:postgres": "npm run build && node scripts/run-postgres-integration.js",
    "test:container": "node scripts/verify-runtime-image.js",
    "test:operations": "npm run build && node --test test/user-journey.test.js && node scripts/run-postgres-integration.js && node scripts/verify-runtime-image.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "deploy:init": "npm run prisma:migrate:deploy && npm run build:seed && node dist-seed/seed.js"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@grammyjs/runner": "2.0.3",
    "@js-temporal/polyfill": "0.5.1",
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/schedule": "^6.1.0",
    "@prisma/client": "^6.19.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "form-data": "^4.0.5",
    "grammy": "^1.39.3",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "prisma": "^6.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
