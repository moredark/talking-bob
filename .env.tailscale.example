# Optional override for the loopback-only admin gateway.
ADMIN_PORT=8080

# Required only with compose.tailscale.production.yml.
# Publish admin/Dockerfile to a registry and pin the release by digest.
TALKING_BOB_ADMIN_IMAGE=registry.example/talking-bob-admin
TALKING_BOB_ADMIN_DIGEST=sha256:replace_with_image_digest
